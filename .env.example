# Copy this file to .env and fill in your project's values.
# Find these in your Supabase project: Settings -> API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The Supabase edge function's GEMINI_API_KEY is set separately, as a
# Supabase secret (Edge Functions -> Manage secrets) — it must never go in
# this file, since anything here is bundled into the client and shipped
# to the browser.
